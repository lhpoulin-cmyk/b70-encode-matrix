#!/usr/bin/env bash
set -Eeuo pipefail
section() { printf '\n[%s]\n' "$1"; }
section identity; hostnamectl 2>&1 || true; cat /etc/os-release; uname -a; id
section pci; lspci -nnk | sed -n '/VGA compatible controller/,+4p'
section dri; ls -la /dev/dri 2>&1 || true; stat -c '%n owner=%U group=%G mode=%a' /dev/dri/* 2>&1 || true
section vainfo; LIBVA_DRIVER_NAME=iHD vainfo --display drm --device /dev/dri/renderD128 2>&1 || true
section ffmpeg; type -a ffmpeg 2>&1 || true; command -v ffmpeg >/dev/null && { readlink -f "$(command -v ffmpeg)"; ffmpeg -hide_banner -version; ffmpeg -hide_banner -buildconf | grep -E -- '--(enable|disable)-lib(vpl|mfx)' || true; ffmpeg -hide_banner -encoders | grep -E 'av1_(qsv|vaapi)' || true; }
section packages; dpkg-query -W ffmpeg libvpl2 libvpl-tools libmfx-gen1.2 intel-media-va-driver-non-free vainfo 2>&1 || true
section libraries; ldconfig -p | grep -E 'libvpl|libmfx' || true
section vpl; command -v vpl-inspect 2>&1 || true; vpl-inspect 2>&1 || true
section makemkv; makemkvcon -r info disc:9999 2>&1 | head -n 3 || true
section workspace; df -h /srv/b70-encode 2>&1 || true; df -i /srv/b70-encode 2>&1 || true
section mounts; for p in /mnt/media/source /mnt/media/work /mnt/media/output /mnt/media/archive; do findmnt -M "$p" -n -o TARGET,SOURCE,FSTYPE,OPTIONS 2>/dev/null || printf '%s: not mounted\n' "$p"; done
