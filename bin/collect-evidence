#!/usr/bin/env bash
set -Eeuo pipefail
root=/srv/b70-encode/evidence
label=${1:-state}
[[ "$label" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "invalid label" >&2; exit 64; }
dest="$root/$(date -u +%Y%m%dT%H%M%SZ)-$label"
umask 0027
mkdir -p "$dest"
run() { local name=$1; shift; { printf '$'; printf ' %q' "$@"; printf '\n'; "$@"; } >"$dest/$name.txt" 2>&1 || true; }
run hostname hostnamectl
run os cat /etc/os-release
run kernel uname -a
run identity id
run mounts findmnt
run disks lsblk -o NAME,MODEL,SERIAL,SIZE,FSTYPE,MOUNTPOINTS
run pci lspci -nnk
run dri ls -la /dev/dri
run ffmpeg-version ffmpeg -hide_banner -version
run ffmpeg-build ffmpeg -hide_banner -buildconf
run ffmpeg-encoders ffmpeg -hide_banner -encoders
run packages dpkg-query -W ffmpeg libvpl2 libvpl-tools libmfx-gen1.2 intel-media-va-driver-non-free vainfo
run libraries ldconfig -p
run vainfo env LIBVA_DRIVER_NAME=iHD vainfo --display drm --device /dev/dri/renderD128
run vpl-inspect vpl-inspect
printf '%s\n' "$dest"

